{
  "name": "agent-empire",
  "version": "1.0.0",
  "description": "Personal Empire OS — operator cockpit for the operator stack (DoneAi, Shopify, agents)",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/saifsoub/AgentEmpire.git"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "install:local": "npm ci --no-audit --no-fund",
    "dev": "next dev -p 7483",
    "boot:local": "npm run dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "deploy:verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@composio/core": "^0.10.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^4.1.2"
  }
}
